# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_REGION=CA
# Optionally override the default 7-day search window
TREND_WINDOW_DAYS=7
# Optional local OAuth paths; credentials files must stay in .secrets/
YOUTUBE_CLIENT_SECRET=.secrets/client_secret.json
YOUTUBE_OAUTH_TOKEN=.secrets/token.json
# Only use this for owned/permission-cleared footage
