# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_REGION=CA
TREND_WINDOW_DAYS=7
# OAuth desktop client (Google Cloud > Credentials > OAuth client ID > Desktop app); keep in .secrets/
YOUTUBE_CLIENT_SECRET=.secrets/client_secret.json
YOUTUBE_OAUTH_TOKEN=.secrets/token.json
# Optional LLM re-rank via any OpenAI-compatible endpoint (e.g. Gemini free tier, Groq, OpenRouter)
LLM_API_KEY=

# ---- Web app (trendtide web) ----
TT_DEV=1                          # 0 in production
TT_SECRET_KEY=                    # python -c "import secrets;print(secrets.token_urlsafe(48))"
TT_BASE_URL=http://127.0.0.1:8000 # https://your-domain in production
TT_ALLOWED_HOSTS=127.0.0.1,localhost
TT_WORKERS=1
TT_MAX_UPLOAD_MB=4096
TT_SOURCE_RETENTION_DAYS=7
TT_TRUSTED_PROXIES=127.0.0.1
STRIPE_SECRET_KEY=                # sk_test_... first; sk_live_... only after testing
STRIPE_WEBHOOK_SECRET=            # whsec_... from Dashboard > Developers > Webhooks (or `stripe listen`)
STRIPE_PRICE_DAILY=               # filled by: trendtide stripe-setup
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_AUTOMATIC_TAX=0            # 1 after enabling Stripe Tax
GOOGLE_OAUTH_WEB_CLIENT=.secrets/google_web_client.json   # OAuth "Web application" client for channel verification
